[Unit]
Description=isuride-matcher
After=isuride-go.service
After=isuride-node.service
After=isuride-perl.service
After=isuride-php.service
After=isuride-python.service
After=isuride-ruby.service
After=isuride-rust.service

[Service]
User=isucon
Group=isucon
EnvironmentFile=/home/isucon/env.sh

# アプリは同じノードで動いている（nginx は isucon14-1）ので、nginx を通さず直接叩く
ExecStart=/bin/sh -c "while true; do curl -s http://127.0.0.1:8080/api/internal/matching; sleep $ISUCON_MATCHING_INTERVAL; done"
ExecStop=/bin/kill -s QUIT $MAINPID

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
